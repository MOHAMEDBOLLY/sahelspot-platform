# Copy this file to .env and fill in real values. Never commit .env.

# Supabase PostgreSQL connection string.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# development | staging | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Supabase project JWT secret (Project Settings -> API -> JWT Secret).
# Used only to verify tokens the frontend already obtained from Supabase
# Auth — the backend never calls Supabase's Auth API itself.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

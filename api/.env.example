# Copy this file to .env and fill in real values. Never commit .env.

# Supabase PostgreSQL connection string.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# development | staging | production
ENVIRONMENT=development

# Sprint 30 — comma-separated list of origins allowed to call this API from
# a browser. Defaults to the Studio dev server if unset; production
# deployments must list their real deployed frontend origin(s) here.
#
# Local dev against the *production* API (e.g. a dev machine that can't run
# the API locally) needs its localhost origins added to the deployed
# server's ALLOWED_ORIGINS too, not just here — this file only controls
# apps that read this repo's own .env. Include both Studio's Vite port
# (5173) and Consumer's Next.js port (3000), each as both localhost and
# 127.0.0.1 (browsers treat them as distinct origins).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Testing -----------------------------------------------------------
# The ONLY database variable pytest reads. It deliberately does not fall
# back to DATABASE_URL: the suite publishes, deletes, and rewrites
# editorial rows, and must never touch the database configured above.
#
# Leave unset and it defaults to
#   postgresql+psycopg://postgres:postgres@127.0.0.1:5432/sahelspot_test
# Managed-provider hosts (Supabase et al.) are refused unconditionally,
# and non-loopback hosts are refused unless ALLOW_REMOTE_TEST_DATABASE=1.
# See docs/TESTING.md and api/tests/database_guard.py.
#TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/sahelspot_test

# Supabase project JWT secret (Project Settings -> API -> JWT Secret).
# Used only to verify tokens the frontend already obtained from Supabase
# Auth — the backend never calls Supabase's Auth API itself.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# C1 — controls what happens when a Supabase identity with a valid,
# verified token has no matching app_users row (i.e. their first request
# ever, or their Supabase account exists but was never provisioned here).
#
# true  = current default behavior: auto-provision them as `viewer`
#         (Sprint 24's original design). Nothing to configure to keep
#         today's behavior exactly as-is.
# false = reject them instead, with a 403 `user_not_authorized` response.
#         Requires provisioning intended users manually beforehand (an
#         app_users row, or a future admin-facing invite flow). Set this
#         once open Supabase signup is a real, accepted risk to close —
#         without it, anyone who can sign up to the Supabase project gets
#         read access to the entire /editor/* surface as a `viewer`.
#
# The one configured BOOTSTRAP_ADMIN_USER_ID is exempt from this in
# either state, so a fresh deployment can always be entered.
AUTO_PROVISION_USERS=true

# Sprint 25 — Media Library Foundation. Optional: unset means media upload
# returns 503 rather than the app failing to start. SUPABASE_URL is the
# project's base URL (Project Settings -> API -> Project URL);
# SUPABASE_SERVICE_ROLE_KEY is the service_role key (never expose this to
# the frontend — it's used server-side only, to upload to Storage on the
# editor's behalf). MEDIA_BUCKET must exist and be public-read in Supabase
# Storage; defaults to "venue-media" if unset.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
MEDIA_BUCKET=venue-media

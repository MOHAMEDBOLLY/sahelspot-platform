# Copy to .env.local to override. Defaults to http://localhost:8000 if unset.
VITE_API_BASE_URL=http://localhost:8000

# Supabase project — Project Settings -> API. The anon key is safe to
# expose in frontend code; it identifies the project, it does not
# authenticate as any particular user.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

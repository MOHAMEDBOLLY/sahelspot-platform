# Copy to .env.local to override. Defaults to http://localhost:8000 if unset.
VITE_API_BASE_URL=http://localhost:8000

# Supabase project — Project Settings -> API. The anon key is safe to
# expose in frontend code; it identifies the project, it does not
# authenticate as any particular user.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Mapbox — Account -> Access tokens. Public tokens are designed to be
# exposed in frontend code (same trust level as the Supabase anon key
# above); scope it to your token URL restrictions in the Mapbox dashboard
# rather than relying on secrecy. Only used by the /map page.
VITE_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

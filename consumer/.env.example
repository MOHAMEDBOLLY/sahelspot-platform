# Copy to .env.local to override. Defaults to http://localhost:8000 if unset.
# Points at the API's /public/* routes only — this app has no auth and
# never calls /editor/*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# PostHog product analytics (anonymous behavioral events only — no accounts,
# no identify() calls). Leave unset to disable analytics entirely, e.g. in
# CI or local dev without a PostHog project — see lib/analytics/posthog.ts.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
